{
  "name": "@compositor/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "compositor-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke-test": "npm run build && node scripts/smoke-test.js",
    "test:tools": "npm run build && node scripts/test-tools.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
